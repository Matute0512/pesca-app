# pnpm + Expo SDK 54
# Expo CLI resuelve `metro-runtime` desde node_modules raíz (require.resolve sin paths).
# Este patrón hoistea los paquetes de Metro para que el bundler los encuentre.
public-hoist-pattern[]=*metro*

# No preguntar por TTY cuando hay que recrear node_modules (relink por hoisting).
confirmModulesPurge=false
