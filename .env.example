# ─────────────────────────────────────────────────────────────
# PescaBA — Variables de entorno (ejemplo)
# Copiá este archivo a `.env` y completá los valores reales.
# ⚠️ Nunca commitees `.env`.
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_API_URL=http://localhost:3000

# --- Base de datos (PostgreSQL + PostGIS) ---
# Formato Prisma: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://pesca:pesca_dev_password@localhost:5432/pesca_ba?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
# Generar en dev: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-bytes-minimum
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-bytes-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ---
# Lista separada por comas de orígenes permitidos.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Storage S3 (dev: MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pesca-ba
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/pesca-ba

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Logging / observabilidad ---
LOG_LEVEL=info
SENTRY_DSN=

# --- Búsqueda ---
# Meilisearch es opcional y no se usa en el MVP.
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=pesca_dev_master_key

# --- Geocoding (opcional, para importación) ---
# Proveedor: "none" | "nominatim" | "mapbox" | "maptiler"
GEOCODING_PROVIDER=none
GEOCODING_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# --- Seed ---
# Cantidad de lugares demo que genera el seed.
SEED_DEMO_SITES=20
