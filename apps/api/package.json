{
  "name": "@pescaba/api",
  "version": "0.1.0",
  "private": true,
  "description": "PescaBA — API REST (NestJS)",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
