# ⚠️ Plantilla para el CLI de Prisma (migrate/seed/studio).
# Copiar a `apps/api/.env` (git-ignored).
# El runtime del API lee el .env raíz (ConfigModule → ../../.env).
# En producción, la DATABASE_URL se inyecta como variable de entorno del proceso.
DATABASE_URL=postgresql://pesca:pesca_dev_password@localhost:5432/pesca_ba?schema=public
