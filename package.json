{
  "name": "pesca-ba",
  "version": "0.1.0",
  "private": true,
  "description": "PescaBA — Aplicación para descubrir lugares de pesca (MVP Provincia de Buenos Aires)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter api test:e2e",
    "dev:api": "pnpm --filter api start:dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:worker": "pnpm --filter worker start:dev",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:migrate:dev": "pnpm --filter api prisma:migrate:dev",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:studio": "pnpm --filter api prisma:studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
